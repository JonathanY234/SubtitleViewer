<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="How to Use"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:paddingBottom="24dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp"
                android:text="This app plays back subtitles. Made for people with hearing loss, or anyone who simply prefers to watch content with subtitles even when the content doesn't offer integrated subtitles."
                android:textColor="#CCCCCC"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Download Subtitles"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download subtitles to your device. opensubtitles.com provides a large selection of subtitles for free.\nSubtitles must be in the .srt format or a ZIP archive containing a .srt file."
                android:textColor="#CCCCCC"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/openSubtitlesLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:text="opensubtitles.com"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="normal"
                android:autoLink="web" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Select Subtitle File"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Subtitle File"
                android:clickable="false"
                android:focusable="false"

                app:backgroundTint="#000000"
                app:cornerRadius="16dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Start Subtitle Playback"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If the subtitles were created for the exact same edition of the film you are watching, press:"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start From Beginning"
                android:clickable="false"
                android:focusable="false"

                app:backgroundTint="#000000"
                app:cornerRadius="16dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If the subtitles are for a different edition or release, their timing may not match your video. In this case, use:"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start From First Line"
                android:clickable="false"
                android:focusable="false"

                app:backgroundTint="#000000"
                app:cornerRadius="16dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="when the first spoken line of the video appears."
                android:textColor="#CCCCCC"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Adjust timing offset"
                android:paddingTop="10dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="On the Subtitle Display screen, tap anywhere to bring up the media controls"
                android:textColor="#CCCCCC"
                android:textSize="16sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btnBackBig"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_btn_backward_big"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="backward big"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" and "
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
                <ImageButton
                    android:id="@+id/btnForwardBig"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_btn_forward_big"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="forward big"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Adjust timing ± 5 Seconds"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btnBackSmall"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_btn_backward_small"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="backward small"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" and "
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
                <ImageButton
                    android:id="@+id/btnForwardSmall"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_btn_forward_small"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="forward small"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Adjust timing ± 0.5 Seconds"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/btnRotate_screen"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/rotate_screen"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="rotate screen"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Rotate Screen"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                    </LinearLayout>

        </LinearLayout>

        </ScrollView>

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:onClick="ReturnToMainActivity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/go_back" />

    </androidx.constraintlayout.widget.ConstraintLayout>
